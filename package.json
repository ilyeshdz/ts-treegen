{
  "name": "ts-treegen",
  "version": "1.0.0",
  "description": "Tiny, low-level engine for programmatic file generation.",
  "homepage": "https://github.com/ilyeshdz/ts-treegen#readme",
  "bugs": {
    "url": "https://github.com/ilyeshdz/ts-treegen/issues"
  },
  "license": "MIT",
  "author": "Ilyes Hernandez <hdz.ilyes@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyeshdz/ts-treegen.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./node": "./dist/node.mjs",
    "./deno": "./dist/deno.mjs",
    "./bun": "./dist/bun.mjs",
    "./memory": "./dist/memory.mjs",
    "./cloudflare": "./dist/cloudflare.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "release-it",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^26.6.4",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "release-it": "^20.2.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.10.1"
}
